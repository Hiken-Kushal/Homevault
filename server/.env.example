# HomeVault AI - Backend Environment Variables
PORT=3001

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Primary Gemini Model
# Default: gemini-3.8-flash (will automatically fallback to gemini-3.5-flash-lite, gemini-3.7-flash if unavailable)
GEMINI_MODEL=gemini-3.8-flash
